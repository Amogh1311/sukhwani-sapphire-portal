{
  "name": "sukhwani-sapphire-portal-root",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:api": "npm --prefix api run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "npm-run-all --parallel dev:api dev:client",
    "build": "npm --prefix client run build",
    "install:all": "npm --prefix api install && npm --prefix client install"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
