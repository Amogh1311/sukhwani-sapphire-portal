# Environment variables — copy to .env.local (not committed) and set in
# Vercel project settings for production.
#
# DATABASE_URL — Postgres connection string. Neon free tier:
#   postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/sukhwani?sslmode=require
#
# ALLOWED_ORIGIN — CORS origin for the API. Use your Vercel URL in prod:
#   https://sukhwani-sapphire.vercel.app
# Use '*' for local development.
#
# ---------- Notifications (all optional) ----------
# If none of the channel vars below are set, notifications still work — they
# just go to the `log` channel (rows written to notification_log table).
# Pick any combination. Recipients are stored in the `notification_recipients`
# DB table; phone numbers must be E.164 (e.g. +919545208412).
#
# WhatsApp Cloud API (Meta) — primary channel. Free tier: 1000 service
# conversations/month. Apply at business.facebook.com → WhatsApp → API Setup.
# WHATSAPP_TOKEN=...
# WHATSAPP_PHONE_ID=...
#
# SMS via Twilio — paid (≈₹0.20/SMS in India).
# SMS_PROVIDER=twilio
# SMS_ACCOUNT_SID=...
# SMS_AUTH_TOKEN=...
# SMS_FROM=...
#
# Email via Resend — free tier: 100 emails/day.
# EMAIL_PROVIDER=resend
# EMAIL_API_KEY=...
# EMAIL_FROM=Sukhwani Sapphire <hello@yourdomain.in>
